# העתיקו את הקובץ הזה ל-.env.local כדי לבדוק במחשב (הקובץ לא עולה לגיטהאב).
# באתר החי הערכים מגיעים מ-GitHub: Settings > Secrets and variables > Actions > Secrets.

# Client ID של אפליקציית PayPal (ציבורי — לא ה-Secret!)
VITE_PAYPAL_CLIENT_ID=

# כתובת הפרויקט ב-Supabase, למשל https://abcd1234.supabase.co
VITE_SUPABASE_URL=

# כתובת האתר המלאה, לתמונת השיתוף בוואטסאפ/פייסבוק (ב-GitHub Actions מתמלא אוטומטית)
VITE_SITE_URL=
