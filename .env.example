# העתיקו את הקובץ הזה ל-.env.local כדי לבדוק את PayPal במחשב (הקובץ לא עולה לגיטהאב).
# באתר החי הערכים מגיעים מ-GitHub: Settings > Secrets and variables > Actions > Variables.

# Client ID של אפליקציית PayPal (מותר לחשוף — זה מזהה ציבורי, לא סוד)
VITE_PAYPAL_CLIENT_ID=

# מזהה הכפתור (hostedButtonId) למשלוח עד הבית
VITE_PAYPAL_BUTTON_SHIPPING=

# מזהה הכפתור (hostedButtonId) לאיסוף עצמי — השאירו ריק אם אין איסוף עצמי
VITE_PAYPAL_BUTTON_PICKUP=

# כתובת האתר המלאה, לתמונת השיתוף בוואטסאפ/פייסבוק (ב-GitHub Actions מתמלא אוטומטית)
VITE_SITE_URL=
